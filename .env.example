# MABGP environment configuration — copy to .env and fill in
# All keys below are FREE TIER. Nothing here costs money.

# --- LLM providers -----------------------------------------------------------
# Groq free tier: 14,400 requests/day  -> https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini free tier -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama local fallback (no key needed). Docker service name inside compose.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# --- Model selection ---------------------------------------------------------
GROQ_MODEL_FAST=llama-3.1-8b-instant
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
# NOTE: gemini-1.5-flash (named in the original spec) is retired and 404s for new
# API keys; gemini-2.5-flash is closed to new users. Verify with ListModels.
# flash-lite answers the intent prompt in ~63 tokens vs ~394 for full flash.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASELINE_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1

# --- External data APIs ------------------------------------------------------
# Google Maps Places API (New) — $200 free credit/month
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Serper.dev — 2,500 free searches/month -> https://serper.dev/api-key
SERPER_API_KEY=

# --- Storage -----------------------------------------------------------------
SQLITE_PATH=./data/mabgp.db
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# --- User / website data layer (MongoDB Atlas) -------------------------------
# SEPARATE from the agent stores above (SQLite + ChromaDB hold agent data only).
# User accounts / application data live in MongoDB so the schema can evolve.
# Free tier: MongoDB Atlas M0 shared cluster -> https://cloud.mongodb.com
# MONGODB_URI is the full connection string, e.g.
#   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGO_DB_NAME=orion_app

# --- Authentication (JWT) ----------------------------------------------------
# Generate a strong secret, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The dev default boots the app but is INSECURE — set this outside development.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Set true when serving over HTTPS so the refresh cookie is TLS-only.
COOKIE_SECURE=false

# --- Runtime -----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# 120s is sized for Groq/Gemini (the 60-90s target in the paper).
# An Ollama-only run executes all 21 agents on local CPU and takes ~120-150s,
# so raise this to 600 when running without any API key.
GENERATION_TIMEOUT_SECONDS=120

# --- Feature flags (F10 routing, F41 freshness, expansions) ------------------
ENABLE_PLACES_API=true
ENABLE_SERPER_API=true
ENABLE_CHROMA_CACHE=true
ENABLE_DYNAMIC_ROUTING=true
